{
  "name": "instagram-post-exporter-firefox",
  "version": "0.2.0",
  "private": true,
  "description": "Firefox WebExtension that exports the currently open Instagram post/reel (visible images + caption) as a local ZIP file or a single embedded Markdown file.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "web-ext lint --ignore-files=test/** --ignore-files=docs/**",
    "start": "web-ext run -s .",
    "build": "web-ext build --overwrite-dest --ignore-files=test/** --ignore-files=docs/** --ignore-files=package.json --ignore-files=package-lock.json --ignore-files=README.md --ignore-files=.gitignore"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "license": "MIT"
}
