{
  "name": "social-post-exporter-firefox",
  "version": "0.3.0",
  "private": true,
  "description": "Firefox WebExtension that exports Instagram and LinkedIn posts/reels/carousels (visible content + images) as local ZIP or embedded Markdown files. No server, no scraping, no automation.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "web-ext lint --ignore-files=test/** --ignore-files=docs/**",
    "start": "web-ext run -s .",
    "build": "web-ext build --overwrite-dest --ignore-files=test/** --ignore-files=docs/** --ignore-files=package.json --ignore-files=package-lock.json --ignore-files=README.md --ignore-files=.gitignore",
    "sign": "web-ext sign --channel=unlisted --ignore-files=test/** --ignore-files=docs/** --ignore-files=package.json --ignore-files=package-lock.json --ignore-files=README.md --ignore-files=.gitignore"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "license": "MIT"
}